{
  "name": "skyl-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli",
    "test": "node --test --experimental-strip-types packages/*/test/*.test.ts",
    "typecheck": "tsc -b packages/core packages/cli --force",
    "bundle": "node scripts/build-bundle.mjs",
    "lint:registry": "node packages/cli/dist/bin.js lint ../skyl/skills --strict"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
