{
  "name": "skyl.dev",
  "version": "0.1.1",
  "description": "Install curated AI agent skills for what your project actually uses",
  "type": "module",
  "license": "MIT",
  "bin": {
    "skyl": "dist/bin.js"
  },
  "files": [
    "dist",
    "bundle.json",
    "README.md"
  ],
  "keywords": [
    "ai",
    "agent",
    "skills",
    "claude",
    "cursor",
    "llm"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "prepack": "tsc -b && node ../../scripts/build-bundle.mjs"
  },
  "dependencies": {
    "@skyl/core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "bundleDependencies": [
    "@skyl/core"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyl-dev/skyl.dev.git",
    "directory": "packages/cli"
  },
  "homepage": "https://skyl.dev",
  "author": "ahmmedrejowan"
}
