---
import Base from '../layouts/Base.astro';
import { loadDoc } from '../lib/registry.ts';

const docs = [
  { slug: 'format', title: 'Skill format', file: 'FORMAT.md', blurb: 'What a skill file is, and which half of it reaches the model.' },
  { slug: 'axes', title: 'The axes', file: 'AXES.md', blurb: 'Five of them. A rule belongs to exactly one.' },
  { slug: 'admission', title: 'Admission', file: 'ADMISSION.md', blurb: 'The four tests a rule has to pass to be published.' },
];

const rendered = await Promise.all(
  docs.map(async (doc) => {
    const html = await loadDoc('spec', doc.file);
    // pull the h2s out for the rail, so a reader can see the shape before reading it
    const headings = [...(html ?? '').matchAll(/<h2[^>]*>(.*?)<\/h2>/g)].map((m) => {
      const text = m[1]!.replace(/<[^>]+>/g, '').trim();
      return { text, id: `${doc.slug}-${text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}` };
    });
    return { ...doc, html, headings };
  }),
);

// give every h2 the id the rail points at
const present = rendered
  .filter((d) => d.html)
  .map((doc) => {
    let i = 0;
    const html = doc.html!.replace(/<h2([^>]*)>/g, () => `<h2 id="${doc.headings[i++]?.id ?? ''}">`);
    return { ...doc, html };
  });
---

<Base title="spec" section="spec" description="The skill format, the axis vocabulary, and the four tests a rule has to pass.">
  <div class="docs">
    <nav class="docs-rail" aria-label="the spec">
      <div class="rail-inner">
        <a class="rail-back" href="/skills">← Skills</a>
        {present.map((doc) => (
          <div class="rail-group">
            <p class="rail-title"><a href={`#${doc.slug}`} data-rail={doc.slug} style="text-decoration: none; color: inherit;">{doc.title}</a></p>
            <ul>
              {doc.headings.map((h) => <li><a href={`#${h.id}`} data-rail={h.id}>{h.text}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </nav>

    <div class="docs-main">
      <header class="docs-head">
        <p class="eyebrow">the standard</p>
        <h1>Spec</h1>
        <p class="docs-lede">
          A registry is only as good as what it refuses. This is what a skill has to be, and what a
          rule has to survive.
        </p>
      </header>

      {present.map((doc) => (
        <section class="spec-doc" id={doc.slug}>
          <h2 class="group-rule"><span>{doc.title}</span></h2>
          <p class="spec-blurb">{doc.blurb}</p>
          <div class="prose scroller spec-prose" set:html={doc.html} />
          <p class="spec-source">
            <a href={`https://github.com/skyl-dev/skyl/blob/main/spec/${doc.file}`}>{doc.file} on GitHub</a>
          </p>
        </section>
      ))}
    </div>
  </div>
</Base>

<style is:global>
  .spec-doc { padding-bottom: var(--sp-7); scroll-margin-top: 5rem; }
  .spec-blurb { margin: 0 0 var(--sp-5); font-size: var(--fs-ui); color: var(--ink-faint); }

  /* This h2 was set at --fs-h3, 16.8px, under body text of 17: the heading was smaller than
     the paragraph it introduced. It is the second rank on the page, below the document title
     and above nothing else, so it takes the step between the two. */
  .spec-prose h2 {
    font-size: var(--fs-sub); font-weight: 600; letter-spacing: -0.02em; color: var(--ink);
    margin: var(--sp-7) 0 var(--sp-3); scroll-margin-top: 5.5rem;
  }
  .spec-prose h2:first-child { margin-top: 0; }
  .spec-prose h3 { margin-top: var(--sp-5); }

  .spec-source { margin: var(--sp-6) 0 0; padding-top: var(--sp-4); border-top: 1px solid var(--rule); font-size: var(--fs-meta); }
  .spec-source a { color: var(--ink-faint); text-decoration: none; }
  .spec-source a:hover { color: var(--accent); }
</style>
