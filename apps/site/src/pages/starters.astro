---
import Base from '../layouts/Base.astro';
import Command from '../components/Command.astro';
import { loadSkills } from '../lib/registry.ts';
import { command, loadStarters, qualified, summarise } from '../lib/starters.ts';

const skills = await loadSkills();
const STARTERS = await loadStarters();

const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const FAMILIES = [...new Set(STARTERS.map((s) => s.family))].sort();
const countIn = (family: string) => STARTERS.filter((s) => s.family === family).length;
---

<Base
  title="starters"
  section="starters"
  description="Presets for the shapes a project actually arrives in, with what each one costs."
>
  <div class="docs">
    <nav class="docs-rail" aria-label="starters">
      <div class="rail-inner">
        <a class="rail-back" href="/#pick">← Compose your own</a>
        <div class="rail-group">
          <p class="rail-title">Family</p>
          <ul>
            <li><button class="pick" type="button" data-family="" data-on>all · {STARTERS.length}</button></li>
            {FAMILIES.map((family) => (
              <li>
                <button class="pick" type="button" data-family={family}>{family} · {countIn(family)}</button>
              </li>
            ))}
          </ul>
        </div>

        <div class="rail-group">
          <p class="rail-title">Shapes</p>
          <ul>
            {STARTERS.map((starter) => (
              <li data-shape={slug(starter.title)}>
                <a href={`#${slug(starter.title)}`} data-rail={slug(starter.title)}>{starter.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>

    <div class="docs-main">
      <header class="docs-head">
        <p class="eyebrow">known shapes</p>
        <h1>Starters</h1>
        <p class="docs-lede">
          If your project looks like one of these, take the line and move on. If it does not,
          <a href="/#pick">compose it</a> or let <code>scan</code> read the build files and propose.
        </p>
      </header>

  <div style="display: grid; gap: var(--sp-3);">
    {STARTERS.map((starter) => {
      const stat = summarise(starter, skills);
      return (
        <article
          id={slug(starter.title)}
          data-families={starter.family}
          style="scroll-margin-top: 5rem; border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--raised); padding: 1.4rem 1.5rem;"
        >
          <div style="display: flex; align-items: baseline; gap: var(--sp-3); flex-wrap: wrap;">
            <h2 style="font-size: var(--fs-h3);">{starter.title}</h2>
            <span class="chip">{stat.skills.length} skills</span>
            <span class="chip">{stat.rules} rules</span>
            <span class="chip">~{stat.tokens.toLocaleString()} tokens</span>
          </div>
          <p style="color: var(--ink-soft); font-size: var(--fs-meta); margin: 0.6rem 0 1.1rem; max-width: 60ch;">{starter.when}</p>
          <Command text={command(qualified(starter))} />
        </article>
      );
    })}
  </div>

  <p style="color: var(--ink-faint); font-size: var(--fs-meta); margin-top: 2rem;">
    {FAMILIES.length === 1 ? 'One family so far.' : `${FAMILIES.length} families, each with its own presets.`}
      A preset for a stack whose skills do not exist yet would be a list of things you cannot install,
      so there is not one.
      </p>
    </div>
  </div>
</Base>

<style is:global>
  .pick {
    display: block; width: 100%; text-align: left; font: inherit; font-size: var(--fs-ui);
    background: none; border: 0; border-left: 2px solid var(--rule); cursor: pointer;
    color: var(--ink-soft); padding: 0.22rem 0 0.22rem 0.7rem;
    transition: color 160ms, border-color 160ms;
  }
  .pick:hover { color: var(--ink); border-color: var(--rule-strong); }
  .pick[data-on] { color: var(--accent); border-color: var(--accent); }
</style>

<script>
  // the shapes list is the table of contents and the family menu cuts it down, so both have
  // to move together: a rail entry pointing at a hidden card is a link to nowhere
  const picks = [...document.querySelectorAll<HTMLButtonElement>('.pick')];
  const cards = [...document.querySelectorAll<HTMLElement>('article[data-families]')];
  const entries = [...document.querySelectorAll<HTMLElement>('[data-shape]')];

  function apply(family: string) {
    for (const card of cards) {
      const shown = family === '' || card.dataset.families!.split(' ').includes(family);
      card.hidden = !shown;
      const entry = entries.find((e) => e.dataset.shape === card.id);
      if (entry) entry.hidden = !shown;
    }
    for (const pick of picks) pick.toggleAttribute('data-on', (pick.dataset.family ?? '') === family);
  }

  for (const pick of picks) {
    pick.addEventListener('click', () => apply(pick.dataset.family ?? ''));
  }
</script>
