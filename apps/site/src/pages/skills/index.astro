---
import Base from '../../layouts/Base.astro';
import { AXIS_ORDER, loadFamilies, tokens } from '../../lib/registry.ts';

const families = await loadFamilies();
const total = families.reduce((n, f) => n + f.skills.length, 0);
const rules = families.reduce((n, f) => n + f.skills.reduce((m, s) => m + s.meta.rules.length, 0), 0);

// the axes a family actually has, in the canonical order, so a family's menu offers the
// axes it can offer rather than all five with four of them dead
const axesOf = (skills: { meta: { axis: string } }[]) =>
  AXIS_ORDER.filter((axis) => skills.some((s) => s.meta.axis === axis)).map((axis) => ({
    axis,
    count: skills.filter((s) => s.meta.axis === axis).length,
  }));

const menu = families.map((family) => ({ ...family, axes: axesOf(family.skills) }));
---

<Base
  title="skills"
  section="skills"
  description="Every published skill, by family and axis. What each one is for, and what it costs in context."
>
  <div class="docs">
    <nav class="docs-rail" aria-label="the registry">
      <div class="rail-inner">
        <a class="rail-back" href="/#pick">← Compose a stack</a>

        <div class="rail-group">
          <p class="rail-title">Family</p>
          <ul>
            <li><button class="pick" type="button" data-pick="all" data-on>all · {total}</button></li>
            {menu.map((family) => (
              <li>
                <button class="pick" type="button" data-pick="family" data-family={family.name}>
                  {family.name} · {family.skills.length}
                </button>
                <ul class="sub">
                  {family.axes.map((a) => (
                    <li>
                      <button class="pick thin" type="button" data-pick="both" data-family={family.name} data-axis={a.axis}>
                        {a.axis} · {a.count}
                      </button>
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </div>

        <div class="rail-group">
          <p class="rail-title">Axis</p>
          <ul>
            <li><button class="pick" type="button" data-pick="axis" data-axis="" data-on>all</button></li>
            {AXIS_ORDER.map((axis) => (
              <li><button class="pick" type="button" data-pick="axis" data-axis={axis}>{axis}</button></li>
            ))}
          </ul>
        </div>
      </div>
    </nav>

    <div class="docs-main">
      <header class="docs-head">
        <p class="eyebrow">the registry</p>
        <h1>{total} skills, {rules} rules</h1>
        <p class="docs-lede">
          Each one is a layer. Install the intersection that matches your project, and nothing else.
        </p>
        <input
          id="filter"
          type="search"
          placeholder="filter by name, axis or dependency"
          autocomplete="off"
        />

        <p id="showing" class="showing"></p>
      </header>

  {families.map((family) => (
    <section id={family.name} style="padding-top: var(--sp-6); scroll-margin-top: 5rem;" data-family={family.name}>
      <h2 style="font-size: var(--fs-ui); text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-faint); margin-bottom: 0.9rem;">
        {family.name} <span style="color: var(--rule-strong);">/</span> {family.skills.length}
      </h2>
      <div class="grid">
        {family.skills.map((skill) => (
          <a
            class="card"
            href={`/skills/${skill.meta.family}/${skill.meta.skill}`}
            data-name={skill.meta.name}
            data-axis={skill.meta.axis}
            data-detect={`${Object.values(skill.meta.detect).flat().join(' ')} ${skill.meta.description}`}
          >
            <div style="display: flex; align-items: baseline; gap: var(--sp-2); margin-bottom: 0.5rem;">
              <strong style="font-weight: 600;">{skill.meta.skill}</strong>
              <span class="chip">{skill.meta.axis}</span>
              <span style="margin-left: auto; color: var(--ink-faint); font-size: var(--fs-micro);">v{skill.meta.version}</span>
            </div>
            <p style="margin: 0 0 0.7rem; color: var(--ink-soft); font-size: var(--fs-ui); line-height: 1.5;">
              {skill.meta.description}
            </p>
            <p style="margin: 0; color: var(--ink-faint); font-size: var(--fs-meta);">
              {skill.rulesCount.must} must{skill.rulesCount.should > 0 ? `, ${skill.rulesCount.should} should` : ''}
              <span style="color: var(--rule-strong);"> · </span>
              ~{tokens(skill.meta.installableWords).toLocaleString()} tokens
            </p>
            {skill.meta.requires.length > 0 && (
              <p style="margin: 0.5rem 0 0; color: var(--ink-faint); font-size: var(--fs-micro);">
                requires {skill.meta.requires.join(', ')}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  ))}

      <p id="empty" hidden style="color: var(--ink-faint); font-size: var(--fs-meta);">Nothing matches that.</p>
    </div>
  </div>
</Base>

<style is:global>
  #filter {
    margin-top: var(--sp-4); width: 100%; max-width: 26rem;
    font: inherit; font-size: var(--fs-ui); padding: 0.55rem 0.8rem;
    border-radius: var(--r-sm); border: 1px solid var(--rule);
    background: var(--raised); color: var(--ink);
  }
  #filter:focus { outline: none; border-color: var(--accent); }
  .showing { margin: var(--sp-3) 0 0; color: var(--ink-faint); font-size: var(--fs-meta); min-height: 1.2em; }

  /* the rail on this page is a menu rather than a table of contents: the registry is one long
     grid, and what a reader wants from the side of it is a way to cut it down */
  .pick {
    display: block; width: 100%; text-align: left; font: inherit; font-size: var(--fs-ui);
    background: none; border: 0; border-left: 2px solid var(--rule); cursor: pointer;
    color: var(--ink-soft); padding: 0.22rem 0 0.22rem 0.7rem;
    transition: color 160ms, border-color 160ms;
  }
  .pick:hover { color: var(--ink); border-color: var(--rule-strong); }
  .pick[data-on] { color: var(--accent); border-color: var(--accent); }
  .sub { list-style: none; margin: 0; padding: 0 0 0 0.7rem; display: grid; gap: 1px; }
  .pick.thin { font-size: var(--fs-meta); color: var(--ink-faint); padding-left: 0.6rem; }
  .pick.thin:hover, .pick.thin[data-on] { color: var(--accent); }
</style>

<script>
  // Filtering happens here because the whole registry is already on the page: with a few
  // dozen skills a search index would be more code than the thing it indexes.
  const input = document.querySelector<HTMLInputElement>('#filter')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.card[data-name]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-family]')];
  const picks = [...document.querySelectorAll<HTMLButtonElement>('.pick')];
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const showing = document.querySelector<HTMLElement>('#showing')!;

  // an empty string on either is "all", which clears that dimension rather than filtering on it
  let family = '';
  let axis = '';

  function apply() {
    const term = input.value.trim().toLowerCase();
    let shown = 0;
    for (const card of cards) {
      const haystack = `${card.dataset.name} ${card.dataset.axis} ${card.dataset.detect}`.toLowerCase();
      const hit =
        (term === '' || haystack.includes(term)) &&
        (family === '' || card.dataset.name!.split('/')[0] === family) &&
        (axis === '' || card.dataset.axis === axis);
      card.hidden = !hit;
      if (hit) shown += 1;
    }
    for (const section of sections) {
      section.hidden = [...section.querySelectorAll<HTMLElement>('.card')].every((c) => c.hidden);
    }
    empty.hidden = shown > 0;

    // a filter that hides most of the page has to say so, or it reads as a smaller registry
    const cut = [family && `family ${family}`, axis && `axis ${axis}`, term && `matching "${term}"`]
      .filter(Boolean)
      .join(', ');
    showing.textContent = cut ? `${shown} of ${cards.length}: ${cut}` : '';

    for (const pick of picks) {
      const { pick: kind, family: f = '', axis: a = '' } = pick.dataset;
      const on =
        kind === 'all' ? family === '' && axis === ''
        : kind === 'family' ? family === f && axis === ''
        : kind === 'both' ? family === f && axis === a
        : /* axis */ axis === a;
      pick.toggleAttribute('data-on', on);
    }
  }

  input.addEventListener('input', apply);
  for (const pick of picks) {
    pick.addEventListener('click', () => {
      const { pick: kind, family: f = '', axis: a = '' } = pick.dataset;
      if (kind === 'all') { family = ''; axis = ''; }
      else if (kind === 'family') { family = f; axis = ''; }
      else if (kind === 'both') { family = f; axis = a; }
      else { axis = a; }   // an axis on its own leaves the family filter where it was
      apply();
    });
  }
  apply();
</script>
