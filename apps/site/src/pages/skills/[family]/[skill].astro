---
import Base from '../../../layouts/Base.astro';
import Command from '../../../components/Command.astro';
import { loadSkills, tokens } from '../../../lib/registry.ts';

export async function getStaticPaths() {
  const skills = await loadSkills();
  return skills.map((skill) => ({
    params: { family: skill.meta.family, skill: skill.meta.skill },
    props: { skill, all: skills },
  }));
}

const { skill, all } = Astro.props;
const meta = skill.meta;

const agentParts = skill.parts.filter((p) => p.forAgent);
const humanParts = skill.parts.filter((p) => !p.forAgent);

// what else composes with this: the layers that need it, and the ones it needs
const neededBy = all.filter((s) => s.meta.requires.includes(meta.name));
const sameFamily = all.filter((s) => s.meta.family === meta.family && s.meta.name !== meta.name);
const detect = Object.entries(meta.detect);
const source = `https://github.com/skyl-dev/skyl/blob/main/skills/${meta.family}/${meta.skill}/SKILL.md`;
---

<Base
  title={meta.name}
  section="skills"
  description={`${meta.rules.length} rules for ${meta.name}. What each one prevents, where it does not apply, and what was measured.`}
>
  <div class="docs">
    <nav class="docs-rail" aria-label={meta.name}>
      <div class="rail-inner">
        <a class="rail-back" href="/skills">← All skills</a>

        <div class="rail-group">
          <p class="rail-title">On this page</p>
          <ul>
            {skill.parts.map((part) => (
              <li>
                <a href={`#${part.heading.toLowerCase()}`} data-rail={part.heading.toLowerCase()}>{part.heading}</a>
              </li>
            ))}
            {skill.references.length > 0 && <li><a href="#references" data-rail="references">References</a></li>}
            {skill.evidence && <li><a href="#evidence" data-rail="evidence">Evidence</a></li>}
          </ul>
        </div>

        {detect.length > 0 && (
          <div class="rail-group">
            <p class="rail-title">Detected by</p>
            {detect.map(([key, values]) => (
              <div>
                <p class="rail-sub">{key.replace(/_/g, ' ')}</p>
                <ul class="rail-facts">{values.map((v) => <li class="detect-item">{v}</li>)}</ul>
              </div>
            ))}
          </div>
        )}

        {neededBy.length > 0 && (
          <div class="rail-group">
            <p class="rail-title">Required by</p>
            <ul>
              {neededBy.map((s) => <li><a href={`/skills/${s.meta.family}/${s.meta.skill}`}>{s.meta.name}</a></li>)}
            </ul>
          </div>
        )}

        {sameFamily.length > 0 && (
          <div class="rail-group">
            <p class="rail-title">Composes with</p>
            <ul>
              {sameFamily.map((s) => <li><a href={`/skills/${s.meta.family}/${s.meta.skill}`}>{s.meta.skill}</a></li>)}
            </ul>
          </div>
        )}

        <div class="rail-group">
          <p class="rail-title">Source</p>
          <ul><li><a href={source}>SKILL.md on GitHub</a></li></ul>
        </div>
      </div>
    </nav>

  <article class="docs-main">
    <header class="docs-head">
      <p class="eyebrow"><a href="/skills" style="text-decoration: none;">skills</a> / {meta.family}</p>
      <h1>{meta.skill}</h1>
      <p class="docs-lede">{meta.description}</p>

      <div style="display: flex; gap: var(--sp-1); flex-wrap: wrap; margin: var(--sp-4) 0 1.5rem;">
        <span class="chip solid">{meta.axis}</span>
        <span class="chip">v{meta.version}</span>
        <span class="chip">{skill.rulesCount.must} must</span>
        {skill.rulesCount.should > 0 && <span class="chip">{skill.rulesCount.should} should</span>}
        <span class="chip">~{tokens(meta.installableWords).toLocaleString()} tokens</span>
        {meta.retired.length > 0 && <span class="chip">{meta.retired.length} retired</span>}
      </div>

      <Command text={`npx skyl.dev add ${meta.name}`} />

      {meta.requires.length > 0 && (
        <p style="margin: 0.9rem 0 0; color: var(--ink-soft); font-size: var(--fs-meta);">
          Installs {meta.requires.map((r) => <a href={`/skills/${r.replace('/', '/')}`}>{r}</a>)} with it, because a layer
          that refers to its core reads wrong without it.
        </p>
      )}
    </header>

      <div>
        {agentParts.map((part) => (
          <section id={part.heading.toLowerCase()} style="margin-bottom: 3rem; scroll-margin-top: 5rem;">
            <div style="display: flex; align-items: center; gap: var(--sp-2); margin-bottom: 1.2rem;">
              <h2 style="font-size: var(--fs-h2); letter-spacing: -0.03em;">{part.heading}</h2>
              <span class="chip solid">installed</span>
            </div>
            <div class="prose scroller" set:html={part.html} />
          </section>
        ))}

        {humanParts.length > 0 && (
          <div style="border-top: 1px solid var(--rule); padding-top: 2.5rem;">
            <p class="eyebrow" style="margin-bottom: 2rem;">
              below this line is for you, and is never sent to a model
            </p>
            {humanParts.map((part) => (
              <section id={part.heading.toLowerCase()} style="margin-bottom: 3rem; scroll-margin-top: 5rem;">
                <h2 style="font-size: var(--fs-h2); letter-spacing: -0.03em; margin-bottom: 1.2rem;">{part.heading}</h2>
                <div class="prose scroller" set:html={part.html} />
              </section>
            ))}
          </div>
        )}

        {skill.references.length > 0 && (
          <div id="references" style="border-top: 1px solid var(--rule); padding-top: 2.5rem; scroll-margin-top: 5rem;">
            <h2 style="font-size: var(--fs-h2); letter-spacing: -0.03em; margin-bottom: 0.5rem;">References</h2>
            <p style="color: var(--ink-faint); font-size: var(--fs-meta); margin-bottom: 1.5rem;">
              Depth a rule points at, loaded only when the agent asks for it.
            </p>
            {skill.references.map((reference) => (
              <details style="border: 1px solid var(--rule); border-radius: var(--radius); padding: 0.9rem 1.1rem; margin-bottom: 0.6rem; background: var(--raised);">
                <summary style="cursor: pointer; font-size: var(--fs-ui);">{reference.title}</summary>
                <div class="prose scroller" style="margin-top: 1.2rem;" set:html={reference.html} />
              </details>
            ))}
          </div>
        )}

        {skill.evidence && (
          <div id="evidence" style="border-top: 1px solid var(--rule); padding-top: 2.5rem;">
            <h2 style="font-size: var(--fs-h2); letter-spacing: -0.03em; margin-bottom: 1.2rem;">Evidence</h2>
            <div class="prose scroller" set:html={skill.evidence} />
          </div>
        )}
      </div>
  </article>
  </div>
</Base>

<style is:global>
  /* a coordinate breaks at its own separators or scrolls, never mid-word */
  .detect-item {
    font-size: var(--fs-meta); line-height: 1.5;
    word-break: normal; overflow-wrap: break-word; hyphens: none;
  }
</style>
