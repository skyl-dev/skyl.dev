---
import Base from '../layouts/Base.astro';
import Command from '../components/Command.astro';
import { evidenceFacts, loadFamilies, loadSkills, tokens } from '../lib/registry.ts';
import { QUESTIONS, START } from '../lib/wizard.ts';

const skills = await loadSkills();
const families = await loadFamilies();

const model = skills.map((s) => ({
  name: s.meta.name,
  family: s.meta.family,
  skill: s.meta.skill,
  axis: s.meta.axis,
  requires: s.meta.requires,
  words: s.meta.installableWords,
  rules: s.meta.rules.length,
}));

const totalRules = skills.reduce((n, s) => n + s.meta.rules.length, 0);
const everything = tokens(skills.reduce((n, s) => n + s.meta.installableWords, 0));

// the terminal is generated from the registry, so it cannot drift from what scan prints
// a plausible project: every axis contributes except service, which is the one that is
// genuinely empty today. An axis reading "not this project" where most projects do have one
// looks like a gap rather than a choice.
const demo = skills.filter((s) =>
  ['core', 'kotlin', 'compose', 'db', 'di', 'networking'].includes(s.meta.skill));

// the five axes, and how much of each a typical project actually takes. This is the whole
// idea in one picture, and it says it without naming a family
const AXES = ['core', 'language', 'framework', 'service', 'topic'] as const;
const facts = await evidenceFacts(families[0]?.name ?? 'android');

// examples rather than inventory: the axis is the idea, and naming the skills inside it
// made a model of everything read like a list of one family
const AXIS_SAYS = [
  {
    n: '01', id: 'core', holds: 'the platform you ship on',
    owns: 'What the system can take away from you. Where state has to survive, what work leaves the main thread, what happens when the process is killed.',
    like: 'Android · iOS · the browser · a server',
  },
  {
    n: '02', id: 'language', holds: 'the language you write',
    owns: 'How that language expresses the decision, and only where it expresses it in a way that goes wrong. Scope, cancellation, nullability, equality.',
    like: 'Kotlin · Swift · TypeScript · Python',
  },
  {
    n: '03', id: 'framework', holds: 'what draws the screen, or serves the request',
    owns: 'The mechanics of one toolkit, where they are particular to it. A rule that would read the same without the framework belongs to core.',
    like: 'Compose · SwiftUI · React · Django',
  },
  {
    n: '04', id: 'service', holds: 'a third party you depend on',
    owns: 'Somebody else\'s API and its own failure modes: what it does under retry, what it charges for, what it silently truncates.',
    like: 'Stripe · Firebase · Supabase · Appwrite',
  },
  {
    n: '05', id: 'topic', holds: 'a concern that cuts across the rest',
    owns: 'Present in most projects and owned by none of the layers above, so it composes with all of them rather than sitting under one.',
    like: 'data · network · permissions · media · tests',
  },
];

const ADMISSION = [
  { n: '01', ask: 'Does the model get this wrong unprompted?', says: 'If it already does the right thing, the rule buys nothing and costs context.' },
  { n: '02', ask: 'Does a linter or the compiler already catch it?', says: 'Tools that run on every build are cheaper and more reliable than a sentence in a prompt.' },
  { n: '03', ask: 'Would 900 of 1000 projects hit it?', says: 'A rule for the other hundred belongs in your own file, not in a shared registry.' },
  { n: '04', ask: 'Is it checkable at every token?', says: 'A reader has to be able to hold it against a file and answer yes or no. Undecidable text is unfollowable.' },
];

const chosen = new Set(demo.map((s) => s.meta.name));
const skipped = skills.filter((s) => !chosen.has(s.meta.name)).slice(0, 3).map((s) => s.meta.skill);
void AXES;
const demoCost = tokens(demo.reduce((n, s) => n + s.meta.installableWords, 0));
---

<Base
  title="skyl"
  description="A composable registry of AI agent skills. Answer a few questions about your project and install the layers that apply to it, not one file that tries to cover everything."
>
  <section class="hero">
    <div>
      <p class="eyebrow">composable agent skills</p>
      <h1>
        Agent rules for<br />
        what your project<br />
        <span class="hl">actually uses</span>.
      </h1>
      <p class="lede">
        Skills are split along five axes, so a project loads the intersection that applies to it.
        Answer four questions, or let the CLI read your build files and propose.
      </p>
      <div class="hero-cta">
        <a class="button" href="#pick">Find your skills</a>
        <a class="button ghost" href="/skills">Browse the skills</a>
      </div>
      <p class="hero-note">
        Works with Claude Code, Cursor, Codex, Windsurf and Continue.
      </p>
    </div>

    <div class="launch">
      <div class="launch-head">
        <p class="launch-label">install</p>
        <Command text="npm i skyl.dev" tone="primary" />
        <p class="launch-label">then, in any project</p>
        <Command text="skyl scan" />
      </div>

      <div class="console">
        <div class="console-bar"><i></i><i></i><i></i><span>~/your-project</span></div>
        <pre><code><span class="t-dim">$</span> skyl scan

  <span class="t-strong">Detected</span>
{demo.slice(0, 3).map((d) => (
  <>{'    '}<span class="t-ok">{d.meta.skill.padEnd(13)}</span><span class="t-dim">{(Object.values(d.meta.detect).flat()[0] ?? '').split('/').pop()!.split(':').pop()}</span>{'\n'}</>
))}    <span class="t-dim">......{' '.repeat(7)}and {demo.length - 3} more</span>

  <span class="t-strong">Ruled out</span>  <span class="t-dim">{skipped.join('  ')}</span>

  {demo.length} layers, ~{(demoCost / 1000).toFixed(1)}k tokens
  <span class="t-dim">Write them? [y/N]</span>
</code></pre>
      </div>

    </div>
  </section>

  <section id="pick" class="picker">
    <div class="picker-head">
      <div>
        <p class="eyebrow">the composer</p>
        <h2>Tell it about the project</h2>
      </div>
    </div>

    <div class="picker-body">
      <div class="steps" id="steps"></div>

      <div id="stage">
        <noscript>
          <p style="color: var(--ink-soft);">
            This part needs JavaScript. <a href="/starters">Starters</a> covers the common shapes
            without it, and <code>npx skyl.dev scan</code> does the same job in a terminal.
          </p>
        </noscript>
      </div>

      <aside class="tally" id="tally">
        <div>
          <p class="eyebrow">so far</p>
          <p class="tally-count"><span id="count">0</span> <small>skills</small></p>
          <p class="tally-sub" id="breakdown">nothing yet</p>
        </div>
        <div>
          <p class="eyebrow">context cost</p>
          <div class="meter"><div id="bar"></div></div>
          <p class="tally-sub"><span id="cost">~0</span> of ~{everything.toLocaleString()} for everything</p>
        </div>
        <ul class="tally-list" id="chosen"></ul>
      </aside>
    </div>
  </section>

  <section class="axes-band">
    <div class="band-head">
      <p class="eyebrow">the model</p>
      <h2>Five axes, and a project draws from the ones that apply</h2>
      <p class="band-say">
        A rule belongs to exactly one. That is what stops two layers restating each other, and what
        lets a project drop the ones it does not use instead of carrying them.
      </p>
    </div>

    <ol class="stack">
      {AXIS_SAYS.map((axis) => (
        <li class="slab">
          <span class="slab-n">{axis.n}</span>
          <div class="slab-body">
            <div class="slab-title">
              <h3>{axis.id}</h3>
              <span class="slab-holds">{axis.holds}</span>
            </div>
            <p class="slab-owns">{axis.owns}</p>
          </div>
          <p class="slab-like">{axis.like}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="admission">
    <div class="band-head">
      <p class="eyebrow">what gets in</p>
      <h2>Four questions, and most candidate rules fail one</h2>
      <p class="band-say">
        The interesting part of a registry is what it refuses. Every rule here had to survive all
        four, and the ones that did not are recorded alongside the ones that did.
      </p>
    </div>

    <div class="tests">
      {ADMISSION.map((test) => (
        <div class="test">
          <span class="test-n">{test.n}</span>
          <h3>{test.ask}</h3>
          <p>{test.says}</p>
        </div>
      ))}
    </div>

    <div class="measured">
      <div><b>{facts['evals'] ?? '26'}</b><span>evals</span></div>
      <div><b>{facts['recorded runs'] ?? '490'}</b><span>recorded runs</span></div>
      <div><b>4</b><span>model families</span></div>
      <div><b>2</b><span>harnesses</span></div>
      <p>
        Every run is published, including the ones that changed nothing.{' '}
        <a href="/evidence">Read the evidence</a>.
      </p>
    </div>
  </section>

  <section class="quick">
    <div class="band-head">
      <p class="eyebrow">shortcuts</p>
      <h2>Or take a known shape</h2>
    </div>
    <div class="quick-grid">
      {[
        { title: 'A new Android app', picks: ['android/core', 'android/kotlin', 'android/compose', 'android/mvvm'] },
        { title: 'A legacy codebase', picks: ['android/core', 'android/java', 'android/xml', 'android/mvvm'] },
        { title: 'An app with a backend', picks: ['android/core', 'android/kotlin', 'android/networking', 'android/db', 'android/security'] },
      ].map((starter) => {
        const list = starter.picks.map((n) => skills.find((s) => s.meta.name === n)!).filter(Boolean);
        const cost = tokens(list.reduce((n, s) => n + s.meta.installableWords, 0));
        return (
          <a class="quick-card" href="/starters">
            <strong>{starter.title}</strong>
            <p>{list.map((s) => s.meta.skill).join(' · ')}</p>
            <span>{list.length} layers · ~{cost.toLocaleString()} tokens</span>
          </a>
        );
      })}
    </div>
  </section>

</Base>

<style is:global>
  .hero {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 4rem; align-items: start; padding: 4rem 0 5.5rem;
  }
  .hero > div:first-child { padding-top: 0.4rem; }
  .hero h1 {
    font-size: clamp(2.3rem, 4.4vw, 3.4rem); line-height: 1.1; letter-spacing: -0.045em;
    margin: 1.6rem 0 2rem; font-weight: 700;
  }
  .hero .eyebrow { display: block; }
  .hero .lede { line-height: 1.62; }
  /* a rule under the phrase, drawn on the element rather than painted behind the text:
     an inset shadow sits at a fixed em offset and drifts off the baseline as the line wraps */
  .hero .hl { position: relative; white-space: nowrap; }
  .hero .hl::after {
    content: ""; position: absolute; left: 0; right: 0; bottom: 0.06em;
    height: 0.09em; background: var(--accent); border-radius: 2px;
  }
  .hero-cta { display: flex; gap: 0.7rem; flex-wrap: wrap; margin: 2.6rem 0 2rem; }
  .hero-note { color: var(--ink-faint); font-size: 13.5px; margin: 0; }

  .button {
    display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none;
    background: var(--accent); color: var(--accent-ink); font-weight: 600; font-size: 15px;
    padding: 0.7rem 1.2rem; border-radius: 9px; border: 1px solid transparent; cursor: pointer;
    font-family: var(--mono);
  }
  .button:hover { filter: brightness(1.04); }
  .button.ghost { background: none; color: var(--ink); border-color: var(--rule-strong); }
  .button.ghost:hover { border-color: var(--accent-line); filter: none; }
  .button.small { font-size: 13px; padding: 0.45rem 0.8rem; }

  /* one card holding the whole idea: the command, then which axes a project actually
     draws from. A transcript said the same thing in far more words and named a family in a
     section that has to speak to every project. */
  .launch {
    border: 1px solid var(--rule); border-radius: 14px; background: var(--raised);
    box-shadow: var(--shadow); overflow: hidden; min-width: 0; align-self: start;
  }
  .launch-head { padding: 1.3rem 1.3rem 1.4rem; display: grid; gap: 0.5rem; }
  .launch-body { padding: 1.2rem 1.3rem; border-top: 1px solid var(--rule); background: var(--sunken); }
  .launch-label {
    margin: 0; font-size: 11.5px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.11em; color: var(--ink-faint);
  }
  .launch-head .launch-label + * { margin-bottom: 0.5rem; }
  .launch-body .launch-label { margin-bottom: 0.9rem; }

  .console { border-top: 1px solid var(--rule); background: var(--sunken); }
  .console-bar {
    display: flex; align-items: center; gap: 0.4rem; padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .console-bar i { width: 8px; height: 8px; border-radius: 50%; background: var(--rule-strong); }
  .console-bar span { margin-left: 0.5rem; font-size: 11.5px; color: var(--ink-faint); }
  .console pre { margin: 0; padding: 0.95rem 1.1rem; font-size: 12.5px; line-height: 1.65; overflow-x: auto; }
  .console code { font-family: var(--mono); white-space: pre; }
  .t-dim { color: var(--ink-faint); }
  .t-strong { color: var(--ink); font-weight: 600; }
  .t-ok { color: var(--term-ok); }


  .picker { margin-top: 1.5rem; border: 1px solid var(--rule); border-radius: 16px; background: var(--raised); box-shadow: var(--shadow); overflow: hidden; scroll-margin-top: 5rem; }
  .picker-head { display: flex; align-items: center; gap: 1rem; padding: 1.5rem 1.8rem 1.4rem; }
  .picker-head h2 { font-size: 1.25rem; margin-top: 0.35rem; }
  .picker-head button { margin-left: auto; }
  .picker-body { display: grid; grid-template-columns: minmax(0, 1fr) 17.5rem; }
  /* sized to the longest step, so answering one does not resize the card under the cursor */
  /* 36rem is what the longest screen needs, measured: the first question at 574px. The
     result used to be the tallest at 607 and is now the shortest at 426, which is what let
     this come down. Pinning costs empty space on the short steps and buys a card that never
     resizes under the cursor. */
  .picker-body > #stage { position: relative; padding: 1.5rem 1.8rem 5.2rem; min-height: 36rem; }
  .steps { grid-column: 1 / -1; display: flex; gap: 2px; height: 3px; }
  .step { flex: 1; background: var(--rule); transition: background 200ms; }
  .step[data-done] { background: var(--accent); }
  /* the current step reads as done when both are the same green, so it is held back */
  .step[data-now] { background: color-mix(in srgb, var(--accent) 38%, var(--rule)); }

  .tally { border-left: 1px solid var(--rule); background: var(--sunken); padding: 1.5rem 1.8rem; display: grid; gap: 1.4rem; align-content: start; }
  .tally-count { font-size: 2.3rem; letter-spacing: -0.04em; margin: 0.3rem 0 0; line-height: 1; font-weight: 600; }
  .tally-count small { font-size: 0.9rem; color: var(--ink-faint); font-weight: 450; letter-spacing: 0; }
  .tally-sub { margin: 0.45rem 0 0; font-size: 13px; color: var(--ink-soft); }
  .meter { height: 6px; border-radius: 3px; background: var(--rule); overflow: hidden; margin-top: 0.5rem; }
  .meter div { height: 100%; width: 0%; background: var(--accent); transition: width 220ms; }
  /* the running list is a readout, not a layout driver: selecting every layer used to make
     it taller than the questions beside it and stretch the whole card */
  .tally-list {
    list-style: none; margin: 0; padding: 0; font-size: 13px; display: grid; gap: 0.3rem;
    max-height: 15rem; overflow-y: auto;
  }
  .tally-list li { color: var(--ink-soft); display: flex; gap: 0.5rem; }
  .tally-list li span { color: var(--ink-faint); margin-left: auto; }

  /* an exact height, not a minimum: the first chip used to arrive and push the question
     down the card */
  .crumbs { display: flex; align-items: center; gap: 0.45rem; height: 1.85rem; overflow: hidden; }
  .crumb {
    font: inherit; font-size: 12.5px; font-weight: 600; line-height: 1.4; cursor: pointer;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 7px; padding: 0.22rem 0.6rem; color: var(--accent);
    white-space: nowrap;
  }
  .crumb:hover { background: color-mix(in srgb, var(--accent) 26%, transparent); border-color: var(--accent); }
  .crumb-sep { color: var(--ink-faint); font-size: 12px; }

  /* the prompt and its help occupy the same block on every screen, so the answers below
     always begin on the same line */
  .q-head { height: 4.6rem; margin: 0.9rem 0 0.2rem; }

  .q-prompt { font-size: 1.35rem; letter-spacing: -0.02em; margin: 0 0 0.45rem; font-weight: 600; }
  .q-help { color: var(--ink-soft); font-size: 14px; margin: 0; min-height: 1.4em; }
  .q-options { display: grid; gap: 0.6rem; }
  /* the one multi-select has seven answers, and stacking them made the card twice the
     height of every other step */
  .q-options[data-multi] { grid-template-columns: 1fr 1fr; }
  @media (max-width: 700px) { .q-options[data-multi] { grid-template-columns: 1fr; } }
  .q-option {
    display: flex; align-items: flex-start; gap: 0.85rem; text-align: left; width: 100%;
    font: inherit; color: inherit; cursor: pointer;
    background: var(--ground); border: 1px solid var(--rule); border-radius: 10px; padding: 0.8rem 1.05rem;
    transition: border-color 120ms, background 120ms;
  }
  .q-option:hover { border-color: var(--rule-strong); }
  .q-option[data-on] { border-color: var(--accent-line); background: color-mix(in srgb, var(--accent) 9%, var(--ground)); }
  .q-option .box { width: 16px; height: 16px; border-radius: 5px; border: 1.5px solid var(--rule-strong); flex: none; margin-top: 2px; position: relative; }
  .q-option[data-on] .box { background: var(--accent); border-color: var(--accent); }
  .q-option[data-on] .box::after {
    content: ""; position: absolute; inset: 3px 3px 4px 3px;
    border-left: 1.6px solid var(--accent-ink); border-bottom: 1.6px solid var(--accent-ink); transform: rotate(-45deg);
  }
  .q-option b { font-weight: 600; display: block; }
  .q-option small { color: var(--ink-faint); font-size: 13px; }
  /* pinned to the bottom of the stage: the answers above it change length every step, and
     a control that moves is a control you have to look for */
  .q-actions {
    position: absolute; left: 1.8rem; right: 1.8rem; bottom: 1.5rem;
    display: flex; gap: 0.6rem; align-items: center;
    padding-top: 1.2rem; border-top: 1px solid var(--rule);
  }
  .q-actions [data-forward] { margin-left: auto; }
  .q-actions [data-forward]:not(:disabled) { color: var(--ink); border-color: var(--rule-strong); }
  .q-btn {
    font: inherit; font-size: 13.5px; cursor: pointer; color: var(--ink-soft);
    background: none; border: 1px solid var(--rule); border-radius: 8px; padding: 0.45rem 0.9rem;
  }
  .q-btn:hover:not(:disabled) { color: var(--ink); border-color: var(--rule-strong); }
  .q-btn:disabled, .button:disabled { opacity: 0.38; cursor: not-allowed; }

  .soon { border: 1px dashed var(--rule-strong); border-radius: 10px; padding: 1.2rem 1.3rem; background: var(--ground); }
  .soon p { margin: 0 0 0.8rem; color: var(--ink-soft); font-size: 14px; }
  .soon p:last-child { margin-bottom: 0; }

  /* columns follow the count, so selecting every layer fills sideways rather than pushing
     the card taller than every other screen */
  .result-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.35rem; margin: 1.1rem 0 0;
  }
  .result-row {
    display: flex; align-items: baseline; gap: 0.55rem; text-decoration: none;
    padding: 0.38rem 0.6rem; border-radius: 7px; background: var(--ground); border: 1px solid var(--rule);
    font-size: 13px;
  }
  .result-row:hover { border-color: var(--rule-strong); }
  .result-row b { font-weight: 600; }
  .result-row .ax { color: var(--ink-faint); font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.05em; }
  .result-row .why { color: var(--ink-faint); font-size: 12px; margin-left: auto; }
  @media (max-width: 700px) { .result-grid { grid-template-columns: 1fr; } }

  .band-head { max-width: 46rem; margin-bottom: 2.5rem; }
  .band-head h2 { font-size: 1.75rem; letter-spacing: -0.03em; margin: 0.7rem 0 1rem; }
  .band-say { color: var(--ink-soft); font-size: 15px; margin: 0; max-width: 60ch; }

  .axes-band { padding: 6rem 0 0; }

  /* a stack of slabs rather than a table: the shape should carry the idea before the words
     do, so each one is a layer sitting on a spine, and the accent runs down the middle of it */
  .stack { list-style: none; margin: 0; padding: 0 0 0 3.5rem; position: relative; }
  .stack::before {
    content: ""; position: absolute; left: 1.1rem; top: 0.8rem; bottom: 0.8rem; width: 1px;
    background: linear-gradient(var(--rule), var(--rule-strong), var(--rule));
  }

  .slab {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 15rem; gap: 2rem;
    padding: 1.35rem 1.4rem; margin-bottom: 0.5rem; align-items: center;
    border: 1px solid var(--rule); border-radius: 12px; background: var(--raised);
    transition: border-color 140ms, transform 140ms, background 140ms;
  }
  .slab::before {
    content: ""; position: absolute; left: -2.42rem; top: 50%; width: 9px; height: 9px;
    border-radius: 50%; background: var(--ground); border: 2px solid var(--rule-strong);
    transform: translateY(-50%); transition: border-color 140ms, background 140ms;
  }
  .slab:hover { border-color: var(--rule-strong); transform: translateX(3px); }
  .slab:hover::before { border-color: var(--accent); background: var(--accent); }

  .slab-n {
    position: absolute; left: -3.5rem; top: 50%; transform: translateY(-50%);
    font-size: 11px; font-weight: 700; color: var(--ink-faint); letter-spacing: 0.05em;
  }
  .slab-body { min-width: 0; }
  .slab-title { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; margin-bottom: 0.45rem; }
  .slab-title h3 { font-size: 1.15rem; letter-spacing: -0.02em; }
  .slab-holds { font-size: 13px; color: var(--accent); }
  .slab-owns { margin: 0; color: var(--ink-soft); font-size: 14.5px; max-width: 62ch; }
  .slab-like {
    margin: 0; font-size: 12.5px; color: var(--ink-faint); text-align: right;
    border-left: 1px solid var(--rule); padding-left: 1.4rem; align-self: stretch;
    display: flex; align-items: center; justify-content: flex-end;
  }

  @media (max-width: 860px) {
    .stack { padding-left: 2.6rem; }
    .stack::before { left: 0.65rem; }
    .slab { grid-template-columns: minmax(0, 1fr); gap: 0.8rem; }
    .slab::before { left: -2rem; }
    .slab-n { left: -2.9rem; }
    .slab-like { text-align: left; border-left: 0; border-top: 1px solid var(--rule); padding: 0.7rem 0 0; justify-content: flex-start; }
  }

  .admission { padding: 6rem 0 0; }
  .tests { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 1.5rem; }
  .test { border-top: 2px solid var(--accent); padding-top: 1rem; }
  .test-n { font-size: 12px; color: var(--accent); font-weight: 700; letter-spacing: 0.06em; }
  .test h3 { font-size: 1rem; margin: 0.5rem 0 0.6rem; }
  .test p { margin: 0; color: var(--ink-soft); font-size: 14px; }

  .measured {
    margin-top: 2.5rem; padding: 1.5rem 1.8rem; border: 1px solid var(--rule); border-radius: 13px;
    background: var(--raised); display: flex; gap: 2.5rem; align-items: baseline; flex-wrap: wrap;
  }
  .measured div { display: grid; }
  .measured b { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.03em; }
  .measured span { font-size: 12px; color: var(--ink-faint); }
  .measured p { margin: 0 0 0 auto; font-size: 13.5px; color: var(--ink-soft); max-width: 26ch; }

  .quick { padding: 6rem 0 2rem; }
  .quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 0.9rem; }
  .quick-card {
    border: 1px solid var(--rule); border-radius: 12px; background: var(--raised);
    padding: 1.2rem 1.3rem; text-decoration: none; display: grid; gap: 0.5rem;
  }
  .quick-card:hover { border-color: var(--rule-strong); }
  .quick-card p { margin: 0; color: var(--ink-soft); font-size: 13px; }
  .quick-card span { font-size: 12px; color: var(--ink-faint); }

  @media (max-width: 820px) {
    .axis-item { grid-template-columns: minmax(0, 1fr); gap: 0.7rem; }
    .measured p { margin-left: 0; }
  }

  @media (max-width: 980px) {
    .hero { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; padding: 3.5rem 0 3rem; }
    .picker-body { grid-template-columns: minmax(0, 1fr); }
    .tally { border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>

<script define:vars={{ model, QUESTIONS, START }}>
  const byName = new Map(model.map((s) => [s.name, s]));
  const questions = new Map(QUESTIONS.map((q) => [q.id, q]));
  const everythingWords = model.reduce((n, s) => n + s.words, 0);
  const estimate = (words) => Math.round((words * 4) / 300) * 100;

  const stage = document.querySelector('#stage');
  const steps = document.querySelector('#steps');
  const els = {
    count: document.querySelector('#count'),
    breakdown: document.querySelector('#breakdown'),
    cost: document.querySelector('#cost'),
    bar: document.querySelector('#bar'),
    chosen: document.querySelector('#chosen'),
  };

  /**
   * Answers outlive the path through them. Going back used to pop the answer with the
   * step, so returning to a question showed it unanswered and the sidebar dropped what it
   * had counted. The path is where you are; the answers are what you said.
   */
  const answers = new Map();
  let path = [];
  let current = START;
  let stalled = null;

  const answerFor = (id) => answers.get(id) ?? [];
  const answered = () => (current && answers.has(current) ? [...path, current] : path);

  function picks() {
    const out = [];
    for (const id of answered()) {
      const question = questions.get(id);
      for (const chosen of answerFor(id)) {
        const option = question.options.find((o) => o.id === chosen);
        for (const pick of option?.picks ?? []) out.push(pick);
      }
    }
    return out;
  }

  function resolve(wanted) {
    const out = new Set();
    const visit = (name) => {
      if (out.has(name)) return;
      const skill = byName.get(name);
      if (!skill) return;
      for (const dep of skill.requires) visit(dep);
      out.add(name);
    };
    for (const name of wanted) visit(name);
    return [...out];
  }

  function renderTally() {
    const all = resolve(picks());
    const list = all.map((n) => byName.get(n));
    const words = list.reduce((n, s) => n + s.words, 0);
    const rules = list.reduce((n, s) => n + s.rules, 0);

    els.count.textContent = String(all.length);
    els.breakdown.textContent = all.length === 0 ? 'nothing yet' : `${rules} rules`;
    els.cost.textContent = `~${estimate(words).toLocaleString()}`;
    els.bar.style.width = `${Math.min(100, (words / everythingWords) * 100)}%`;
    els.chosen.innerHTML = all.length === 0
      ? '<li style="color: var(--ink-faint);">answers add layers here</li>'
      : list.map((s) => `<li>${s.skill}<span>${s.rules}</span></li>`).join('');
    return { all, list, words, rules };
  }

  function renderSteps() {
    const total = 5;
    const done = path.length;
    steps.innerHTML = Array.from({ length: total }, (_, i) => {
      const state = i < done ? ' data-done' : i === done ? ' data-now' : '';
      return `<div class="step"${state}></div>`;
    }).join('');
  }

  function trailMarkup() {
    // the row is always here, empty or not, so answering the first question does not
    // shove everything below it down the page
    const crumbs = path.map((id, i) => {
      const question = questions.get(id);
      const labels = answerFor(id).map((c) => question.options.find((o) => o.id === c)?.label ?? c);
      const say = question.multi
        ? (labels.length === 0 ? 'nothing extra' : `${labels.length} selected`)
        : labels[0];
      return `<button class="crumb" type="button" data-crumb="${i}" title="go back and change this">${say}</button>`;
    });
    return `<div class="crumbs">${crumbs.join('<span class="crumb-sep">/</span>')}</div>`;
  }

  function actionsMarkup(forward) {
    const ahead = forward.label
      ? `<button class="q-btn" type="button" data-forward>${forward.label}</button>`
      : '';
    return `
      <div class="q-actions">
        <button class="q-btn" type="button" data-back${path.length === 0 ? ' disabled' : ''}>Back</button>
        <button class="q-btn" type="button" data-reset${answers.size === 0 ? ' disabled' : ''}>Reset</button>
        ${ahead}
      </div>`;
  }

  function optionMarkup(option, chosen) {
    const on = chosen.includes(option.id) ? ' data-on' : '';
    return `
      <button class="q-option" type="button" data-option="${option.id}"${on}>
        <span class="box"></span>
        <span>
          <b>${option.label}</b>
          ${option.hint ? `<small>${option.hint}</small>` : ''}
        </span>
      </button>`;
  }

  function choose(question, optionId) {
    const option = question.options.find((o) => o.id === optionId);

    if (question.multi) {
      const was = answerFor(question.id);
      answers.set(question.id, was.includes(optionId) ? was.filter((c) => c !== optionId) : [...was, optionId]);
      render();
      return;
    }

    answers.set(question.id, [optionId]);
    if (!path.includes(question.id)) path.push(question.id);
    stalled = option.soon ? option : null;
    current = option.soon ? null : (option.next ?? null);
    render();
  }

  function back() {
    stalled = null;
    current = path.pop() ?? START;
    render();
  }

  function render() {
    renderSteps();
    const { all, list, words, rules } = renderTally();

    if (stalled) {
      stage.innerHTML = `
        ${trailMarkup()}
        <div class="q-head">
          <p class="q-prompt">Not published yet</p>
          <p class="q-help">Nothing here is hidden from you.</p>
        </div>
        <div class="soon">
          <p>${stalled.soon.replace(/`([^`]+)`/g, '<code>$1</code>')}</p>
          <p>The registry says what it covers rather than pretending to cover everything.</p>
        </div>
        ${actionsMarkup({})}`;
      wire(null);
      return;
    }

    if (current === null) {
      const args = all.map((n, i) => (i === 0 ? n : n.split('/')[1]));
      const command = `npx skyl.dev add ${args.join(' ')}`;
      stage.innerHTML = `
        ${trailMarkup()}
        <div class="q-head">
          <p class="q-prompt">${all.length} skills, ${rules} rules</p>
          <p class="q-help">~${estimate(words).toLocaleString()} tokens. Every one is a layer you can drop later.</p>
        </div>
        <div class="command command-primary">
          <span class="sigil">$</span>
          <code data-command>${command}</code>
          <button type="button" data-copy="${command}">copy</button>
        </div>
        <div class="result-grid">
          ${list.map((s) => `
            <a class="result-row" href="/skills/${s.family}/${s.skill}">
              <b>${s.skill}</b>
              <span class="ax">${s.axis}</span>
              <span class="why">${s.rules}</span>
            </a>`).join('')}
        </div>
        ${actionsMarkup({})}`;
      wire(null);
      return;
    }

    const question = questions.get(current);
    const chosen = answerFor(question.id);

    stage.innerHTML = `
      ${trailMarkup()}
      <div class="q-head">
        <p class="q-prompt">${question.prompt}</p>
        <p class="q-help">${question.help ?? ''}</p>
      </div>
      <div class="q-options"${question.multi ? ' data-multi' : ''}>
        ${question.options.map((o) => optionMarkup(o, chosen)).join('')}
      </div>
      ${actionsMarkup(question.multi
        ? { label: chosen.length === 0 ? 'Nothing extra' : 'Done' }
        : { label: chosen.length > 0 ? 'Next' : '' })}`;
    wire(question);
  }

  /**
   * Forward retraces the route already answered, which only works because the answers
   * outlive the path: going back four steps and forward four lands where you were.
   */
  function forward() {
    const question = questions.get(current);
    const chosen = answerFor(current);
    if (!question) return;
    if (!question.multi && chosen.length === 0) return;
    if (!path.includes(question.id)) path.push(question.id);

    if (question.multi) { current = null; render(); return; }
    const option = question.options.find((o) => o.id === chosen[0]);
    stalled = option?.soon ? option : null;
    current = option?.soon ? null : (option?.next ?? null);
    render();
  }

  function wire(question) {
    if (question) {
      for (const button of stage.querySelectorAll('[data-option]')) {
        button.addEventListener('click', () => choose(question, button.dataset.option));
      }
    }
    const backButton = stage.querySelector('[data-back]');
    if (backButton && !backButton.disabled) backButton.addEventListener('click', back);
    const forwardButton = stage.querySelector('[data-forward]');
    if (forwardButton && !forwardButton.disabled) forwardButton.addEventListener('click', forward);
    const resetButton = stage.querySelector('[data-reset]');
    if (resetButton && !resetButton.disabled) resetButton.addEventListener('click', reset);

    for (const crumb of stage.querySelectorAll('[data-crumb]')) {
      crumb.addEventListener('click', () => {
        const at = Number(crumb.dataset.crumb);
        current = path[at];
        path = path.slice(0, at);
        stalled = null;
        render();
      });
    }
  }

  function reset() {
    answers.clear();
    path = [];
    current = START;
    stalled = null;
    render();
  }

  render();
</script>
