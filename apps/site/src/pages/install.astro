---
import Base from '../layouts/Base.astro';
import Command from '../components/Command.astro';
import { loadFamilies } from '../lib/registry.ts';

const families = await loadFamilies();
const total = families.reduce((n, f) => n + f.skills.length, 0);

/**
 * The CLI first, then one section per tool.
 *
 * Everything below runs through the same command, so it is worth meeting once rather than
 * five times in five slightly different forms. Claude Code has a real plugin marketplace,
 * so there it is two lines and no terminal. The rest read rules from a directory, and the
 * only thing that changes between them is which directory. Presenting a deeplink where
 * none exists would be a nicer page and a worse first five minutes.
 */
const TOOLS = [
  {
    id: 'claude',
    name: 'Claude Code',
    kind: 'Plugin marketplace',
    writes: '.claude/skills/',
    steps: [
      { say: 'Add the marketplace, once per machine.', run: '/plugin marketplace add skyl-dev/skyl' },
      { say: 'Install the family you need.', run: '/plugin install skyl-android@skyl' },
    ],
    note: 'Runs inside Claude Code, no terminal. Updates arrive with /plugin marketplace update.',
    caveat: 'The CLI writes a directory per skill: SKILL.md with the name and description Claude Code reads, and references/ beside it.',
    also: 'The CLI works here too, and gives you the lockfile and per-project selection.',
  },
  {
    id: 'cursor',
    name: 'Cursor',
    kind: 'Rules directory',
    writes: '.cursor/rules/',
    steps: [
      { say: 'Let it read the project and propose.', run: 'npx skyl.dev scan --target cursor' },
      { say: 'Or name the layers yourself.', run: 'npx skyl.dev add android/core kotlin compose --target cursor' },
    ],
    note: 'Writes .mdc files with the frontmatter Cursor expects, so each rule stays scoped instead of always-on.',
    caveat: 'One file per skill, so the reference files a rule points at stay behind. add says which ones, and they are on this site under each skill.',
  },
  {
    id: 'codex',
    name: 'Codex',
    kind: 'Reads AGENTS.md',
    writes: '.agents/skills/',
    steps: [{ say: 'Read the project and propose.', run: 'npx skyl.dev scan --target agents' }],
    note: 'Codex picks up the AGENTS.md convention, so it takes the same target as anything else that reads it. Nothing here is Codex-specific.',
    caveat: 'A directory per skill holding SKILL.md, with the reference files beside it.',
  },
  {
    id: 'agents',
    name: 'AGENTS.md',
    kind: 'Open convention',
    writes: '.agents/skills/',
    steps: [{ say: 'Write the shared convention.', run: 'npx skyl.dev scan --target agents' }],
    note: 'The vendor-neutral path. Any tool that reads AGENTS.md picks these up, and nothing in the files names a vendor.',
    caveat: 'A directory per skill holding SKILL.md with name and description, and references/ beside it.',
  },
  {
    id: 'windsurf',
    name: 'Windsurf',
    kind: 'Rules directory',
    writes: '.windsurf/rules/',
    steps: [{ say: 'Read the project and propose.', run: 'npx skyl.dev scan --target windsurf' }],
    note: 'Writes plain markdown with the trigger field Windsurf reads, so each skill applies when its description fits rather than always.',
    caveat:
      'Windsurf reads 6,000 characters of a rule and 12,000 across all of them, and truncates the rest ' +
      'silently. Most skills here are past the first number, so add prints the sizes and you choose what ' +
      'to install. References stay behind for the same reason Cursor\'s do.',
  },
  {
    id: 'continue',
    name: 'Continue',
    kind: 'Rules directory',
    writes: '.continue/rules/',
    steps: [{ say: 'Read the project and propose.', run: 'npx skyl.dev scan --target continue' }],
    note: 'Writes plain markdown with name, description and alwaysApply: false, so a rule is offered rather than always on.',
    caveat: 'One file per skill, so reference files stay behind.',
  },
  {
    id: 'others',
    name: 'Everything else',
    kind: 'Any tool that reads markdown',
    writes: '.agents/skills/',
    steps: [{ say: 'Write the neutral directory, then point your tool at it.', run: 'npx skyl.dev add android/core --target agents' }],
    note:
      'A skill is a markdown file with a heading and a list of rules. There is nothing in it that ' +
      'needs a particular tool, so a tool this page has never heard of reads the same files: write ' +
      'them once and configure it to load that directory.',
    also: 'If your tool wants its own directory or frontmatter, that is a target, and a target is about twenty lines. Open an issue on the CLI repo.',
  },
];
---

<Base
  title="install"
  section="install"
  description="Install skyl skills into Claude Code, Cursor, Codex, Windsurf, Continue, or anything that reads markdown."
>
  <div class="docs">
    <nav class="docs-rail" aria-label="install">
      <div class="rail-inner">
        <a class="rail-back" href="/skills">← Skills</a>

        <div class="rail-group">
          <p class="rail-title">Start</p>
          <ul>
            <li><a href="#cli" data-rail="cli">The CLI</a></li>
          </ul>
        </div>

        <div class="rail-group">
          <p class="rail-title">Your tool</p>
          <ul>
            {TOOLS.map((tool) => (
              <li><a href={`#${tool.id}`} data-rail={tool.id}>{tool.name}</a></li>
            ))}
          </ul>
        </div>

        <div class="rail-group">
          <p class="rail-title">Either way</p>
          <ul>
            <li><a href="#repo" data-rail="repo">What lands in your repo</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="docs-main">
      <header class="docs-head">
        <p class="eyebrow">getting started</p>
        <h1>Install</h1>
        <p class="docs-lede">
          Skills are plain markdown, so every tool that reads a rules directory can use them. One
          command writes them, and the only thing that changes per tool is where.
        </p>
      </header>

      <section class="tool" id="cli">
        <div class="tool-head">
          <h2>The CLI</h2>
          <span class="chip">npm</span>
        </div>
        <ol class="steps-list">
          <li>
            <p>Run it without installing anything. This is the whole of it.</p>
            <Command text="npx skyl.dev scan" />
          </li>
          <li>
            <p>Or keep it around, if you will run it in more than one project.</p>
            <Command text="npm i -g skyl.dev" />
          </li>
          <li>
            <p>Name the layers yourself when you already know them.</p>
            <Command text="skyl add android/core kotlin compose" />
          </li>
        </ol>
        <p class="tool-note">
          <code>scan</code> reads your build files, proposes the {total} skills that match, and writes
          nothing until you say so. Every command takes <code>--target</code> to pick the tool, and
          the full reference is on <a href="/docs">the docs page</a>.
        </p>
      </section>

      {TOOLS.map((tool) => (
        <section class="tool" id={tool.id}>
          <div class="tool-head">
            <h2>{tool.name}</h2>
            <span class="chip">{tool.kind}</span>
            <span class="writes">writes <code>{tool.writes}</code></span>
          </div>
          <ol class="steps-list">
            {tool.steps.map((step) => (
              <li>
                <p>{step.say}</p>
                <Command text={step.run} />
              </li>
            ))}
          </ol>
          <p class="tool-note">{tool.note}</p>
          {tool.caveat && <p class="tool-note tool-caveat">{tool.caveat}</p>}
          {tool.also && <p class="tool-note">{tool.also}</p>}
        </section>
      ))}

      <section id="repo" class="repo">
    <div>
      <h3>What lands in your repo</h3>
      <p>
        One markdown file per skill, containing only the rules, with the reference files its rules
        point at beside it where the tool takes a directory. Plus <code>skyl.lock</code>, recording
        what was written and its content hash. Everything is reviewable in a pull request, and a
        reinstall produces no diff.
      </p>
    </div>
    <div>
      <h3>What does not</h3>
      <p>
        The reasoning, the pitfalls, and the evidence behind each rule stay in the registry. They are
        for you, not for the model, and sending them would spend context on text that changes nothing.
      </p>
    </div>
    <div>
      <h3>Switching tools later</h3>
      <p>
        Run the same command with a different <code>--target</code>. The skills are the same files in
        a different directory, so nothing is locked to one vendor. {families.length} {families.length === 1 ? 'family' : 'families'}, {total} skills today.
      </p>
    </div>
  </section>
    </div>
  </div>
</Base>

<style>
  .tool {
    margin-top: var(--sp-6); border: 1px solid var(--rule); border-radius: var(--r-lg);
    background: var(--raised); padding: 1.8rem; box-shadow: var(--shadow);
  }
  .tool-head { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: 1.6rem; flex-wrap: wrap; }
  .tool-head h2 { font-size: var(--fs-h2); letter-spacing: -0.03em; margin: 0; }
  .writes { margin-left: auto; color: var(--ink-faint); font-size: var(--fs-meta); }
  .writes code { color: var(--ink-soft); }
  .steps-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); counter-reset: step; }
  .steps-list li { counter-increment: step; position: relative; padding-left: 2.2rem; }
  .steps-list li::before {
    content: counter(step); position: absolute; left: 0; top: 0;
    width: 1.5rem; height: 1.5rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--accent); color: var(--accent-ink); font-size: var(--fs-micro); font-weight: 700;
  }
  .steps-list p { margin: 0 0 0.6rem; font-size: var(--fs-body); }
  .tool-note { color: var(--ink-soft); font-size: var(--fs-ui); margin: 1.4rem 0 0; max-width: 64ch; }
  /* what the tool cannot do, rather than what it does. Marked, because someone scanning for
     the command should still see it, and it is the sentence that saves the support message. */
  .tool-caveat {
    color: var(--ink-faint); border-left: 2px solid var(--rule-strong);
    padding-left: var(--sp-3); margin-top: var(--sp-3);
  }
  /* the same mark inline code carries everywhere else, so --target does not read as prose here */
  .tool-note code, .repo code { background: var(--sunken); padding: 0.06em 0.32em; border-radius: var(--r-tiny); color: var(--ink); }

  .repo { padding: var(--sp-7) 0 0; display: grid; gap: var(--sp-6); grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  .repo h3 { font-size: var(--fs-h3); margin: 0 0 0.6rem; }
  .repo p { color: var(--ink-soft); font-size: var(--fs-body); margin: 0; }
</style>
