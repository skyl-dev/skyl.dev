---
import Base from '../layouts/Base.astro';
import Command from '../components/Command.astro';
import { loadFamilies } from '../lib/registry.ts';

const families = await loadFamilies();

/**
 * One tool per tab, with the shortest honest path for each.
 *
 * Claude Code has a real plugin marketplace, so there it is two lines and no terminal.
 * The rest read rules from a directory, so there it is one command that writes that
 * directory. Presenting a deeplink where none exists would be a nicer page and a worse
 * first five minutes.
 */
const TOOLS = [
  {
    id: 'claude',
    name: 'Claude Code',
    kind: 'Plugin marketplace',
    steps: [
      { say: 'Add the marketplace, once per machine.', run: '/plugin marketplace add skyl-dev/skyl' },
      { say: 'Install the family you need.', run: '/plugin install skyl-android@skyl' },
    ],
    note: 'Runs inside Claude Code, no terminal. Updates arrive with /plugin marketplace update.',
    also: 'The CLI works here too, and gives you the lockfile and per-project selection: npx skyl.dev scan',
  },
  {
    id: 'cursor',
    name: 'Cursor',
    kind: 'Rules directory',
    steps: [
      { say: 'Let it read the project and propose.', run: 'npx skyl.dev scan --target cursor' },
      { say: 'Or name the layers yourself.', run: 'npx skyl.dev add android/core kotlin compose --target cursor' },
    ],
    note: 'Writes .cursor/rules/*.mdc with the frontmatter Cursor expects, so each rule stays scoped instead of always-on.',
  },
  {
    id: 'codex',
    name: 'Codex and AGENTS.md',
    kind: 'Open convention',
    steps: [{ say: 'Write the shared convention.', run: 'npx skyl.dev scan --target agents' }],
    note: 'Writes .agents/skills/. Any tool that reads the AGENTS.md convention picks these up, which is the vendor-neutral path.',
  },
  {
    id: 'windsurf',
    name: 'Windsurf',
    kind: 'Rules directory',
    steps: [{ say: 'Read the project and propose.', run: 'npx skyl.dev scan --target windsurf' }],
    note: 'Writes .windsurf/rules/.',
  },
  {
    id: 'continue',
    name: 'Continue',
    kind: 'Rules directory',
    steps: [{ say: 'Read the project and propose.', run: 'npx skyl.dev scan --target continue' }],
    note: 'Writes .continue/rules/.',
  },
];
---

<Base
  title="install"
  section="install"
  description="Install skyl skills into Claude Code, Cursor, Codex, Windsurf or Continue. One command, or two clicks."
>
  <section style="padding: 3.5rem 0 2.5rem;">
    <p class="eyebrow">getting started</p>
    <h1 style="font-size: 2rem; margin: 0.6rem 0 1rem;">Install</h1>
    <p class="lede">
      Skills are plain markdown, so every tool that reads a rules directory can use them. Pick yours.
    </p>
  </section>

  <div class="tools">
    <div class="tool-tabs" role="tablist">
      {TOOLS.map((tool, i) => (
        <button class="tool-tab" type="button" role="tab" data-tool={tool.id} data-on={i === 0 ? '' : undefined}>
          {tool.name}
        </button>
      ))}
    </div>

    {TOOLS.map((tool, i) => (
      <section class="tool-panel" data-panel={tool.id} hidden={i !== 0}>
        <p class="eyebrow" style="margin-bottom: 1.4rem;">{tool.kind}</p>
        <ol class="steps-list">
          {tool.steps.map((step) => (
            <li>
              <p>{step.say}</p>
              <Command text={step.run} />
            </li>
          ))}
        </ol>
        <p class="tool-note">{tool.note}</p>
        {tool.also && <p class="tool-note">{tool.also}</p>}
      </section>
    ))}
  </div>

  <section style="padding: 4rem 0 0; display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));">
    <div>
      <h3 style="font-size: 1rem; margin-bottom: 0.6rem;">What lands in your repo</h3>
      <p style="color: var(--ink-soft); font-size: 14.5px; margin: 0;">
        One markdown file per skill, containing only the rules, plus <code>skyl.lock</code> recording
        what was written and its content hash. Everything is reviewable in a pull request, and a
        reinstall produces no diff.
      </p>
    </div>
    <div>
      <h3 style="font-size: 1rem; margin-bottom: 0.6rem;">What does not</h3>
      <p style="color: var(--ink-soft); font-size: 14.5px; margin: 0;">
        The reasoning, the pitfalls, and the evidence behind each rule stay in the registry. They are
        for you, not for the model, and sending them would spend context on text that changes nothing.
      </p>
    </div>
    <div>
      <h3 style="font-size: 1rem; margin-bottom: 0.6rem;">Switching tools later</h3>
      <p style="color: var(--ink-soft); font-size: 14.5px; margin: 0;">
        Run the same command with a different <code>--target</code>. The skills are the same files in
        a different directory, so nothing is locked to one vendor. {families.length} family, {families[0]?.skills.length ?? 0} skills today.
      </p>
    </div>
  </section>
</Base>

<style>
  .tools { border: 1px solid var(--rule); border-radius: 14px; background: var(--raised); overflow: hidden; box-shadow: var(--shadow); }
  .tool-tabs { display: flex; overflow-x: auto; border-bottom: 1px solid var(--rule); background: var(--sunken); }
  .tool-tab {
    font: inherit; font-size: 14px; font-weight: 500; background: none; border: 0; cursor: pointer;
    padding: 0.95rem 1.2rem; color: var(--ink-faint); white-space: nowrap;
    border-bottom: 2px solid transparent; margin-bottom: -1px;
  }
  .tool-tab:hover { color: var(--ink); }
  .tool-tab[data-on] { color: var(--ink); border-bottom-color: var(--accent); }
  .tool-panel { padding: 1.8rem; }
  .steps-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; counter-reset: step; }
  .steps-list li { counter-increment: step; position: relative; padding-left: 2.2rem; }
  .steps-list li::before {
    content: counter(step); position: absolute; left: 0; top: 0;
    width: 1.5rem; height: 1.5rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--accent); color: var(--accent-ink); font-size: 12px; font-weight: 700;
  }
  .steps-list p { margin: 0 0 0.6rem; font-size: 15px; }
  .tool-note { color: var(--ink-soft); font-size: 14px; margin: 1.4rem 0 0; max-width: 64ch; }
</style>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tool-tab')];
  const panels = [...document.querySelectorAll<HTMLElement>('.tool-panel')];
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      for (const other of tabs) other.toggleAttribute('data-on', other === tab);
      for (const panel of panels) panel.hidden = panel.dataset.panel !== tab.dataset.tool;
    });
  }
</script>
