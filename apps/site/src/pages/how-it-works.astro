---
import Base from '../layouts/Base.astro';
import Command from '../components/Command.astro';
import RuleAnatomy from '../components/RuleAnatomy.astro';
import { loadSkills, tokens } from '../lib/registry.ts';

const skills = await loadSkills();

const BEHAVIOUR = [
  { act: 'It proposes', say: 'scan prints what it matched, what it ruled out, and the token cost. It writes nothing.' },
  { act: 'You confirm', say: 'nothing lands until you say so. --yes exists, for scripts that already know.' },
  { act: 'It is recorded', say: 'skyl.lock holds a hash of every file, so a reinstall is no diff and a pull request shows exactly what moved.' },
  { act: 'It is reversible', say: 'remove takes layers back out, and refuses to orphan one that another still needs.' },
];
---

<Base
  title="how it works"
  section="how"
  description="What a rule is made of, why it is shaped that way, and what the CLI does to your repository before it writes anything."
>
  <div class="docs">
    <nav class="docs-rail" aria-label="how it works">
      <div class="rail-inner">
        <a class="rail-back" href="/#pick">← Compose a stack</a>
        <div class="rail-group">
          <p class="rail-title">How it works</p>
          <ul>
            <li><a href="#a-rule" data-rail="a-rule">What a rule is</a></li>
            <li><a href="#behaviour" data-rail="behaviour">What it does to your repo</a></li>
            <li><a href="#shapes" data-rail="shapes">Known shapes</a></li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="docs-main">
      <header class="docs-head">
        <p class="eyebrow">the shape of it</p>
        <h1>How it works</h1>
        <p class="docs-lede">
          A rule is three parts, a skill is a stack of them, and nothing reaches your repository
          until you say so.
        </p>
      </header>

      <section class="anatomy-band" id="a-rule">
    <div class="band-head">
      <p class="eyebrow" data-reveal="0">what a rule is</p>
      <h2 data-reveal="1">Three parts, always</h2>
      <p class="band-say" data-reveal="2">An instruction you can check, the failure it prevents, and where it stops applying.</p>
    </div>

    <div data-reveal="1"><RuleAnatomy /></div>
      </section>

      <section class="behaviour" id="behaviour">
    <div class="band-head">
      <p class="eyebrow" data-reveal="0">how it behaves</p>
      <h2 data-reveal="1">Nothing is written without asking</h2>
      <p class="band-say">It reads your project, proposes, and waits. Everything it does is reviewable and reversible.</p>
    </div>

    <div class="behaviour-grid">
    <ol class="acts">
      {BEHAVIOUR.map((step, i) => (
        <li class="act" data-reveal={String(i + 1)}>
          <span class="act-n">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <p class="act-name">{step.act}</p>
            <p class="act-say">{step.say}</p>
          </div>
        </li>
      ))}
    </ol>

      <div class="console proof" data-reveal="2">
        <div class="console-bar"><i></i><i></i><i></i><span>~/acme-pay</span></div>
        <pre><code><span class="t-dim">$</span> skyl add compose

  android/core     <span class="t-dim">required by another skill</span>
  android/compose

  3 skills, ~5,500 tokens <span class="t-dim">into .claude/skills</span>
  <span class="t-strong">Write them? [y/N]</span> <span class="t-ok">y</span>

  <span class="t-ok">Done.</span> <span class="t-dim">Recorded in skyl.lock.</span>
</code></pre>
      </div>
    </div>

      </section>

      <section class="quick" id="shapes">
    <div class="band-head">
      <p class="eyebrow" data-reveal="0">shortcuts</p>
      <h2 data-reveal="1">Or take a known shape</h2>
    </div>
    <div class="quick-grid">
      {[
        { title: 'A new app', picks: ['android/core', 'android/kotlin', 'android/compose', 'android/mvvm'] },
        { title: 'A legacy codebase', picks: ['android/core', 'android/java', 'android/xml', 'android/mvvm'] },
        { title: 'An app with a backend', picks: ['android/core', 'android/kotlin', 'android/networking', 'android/db', 'android/security'] },
        { title: 'Media heavy', picks: ['android/core', 'android/kotlin', 'android/compose', 'android/images', 'android/permissions'] },
        { title: 'Adding tests', picks: ['android/core', 'android/kotlin', 'android/testing', 'android/di'] },
        { title: 'Everything', picks: skills.map((s) => s.meta.name) },
      ].map((starter, i) => {
        const list = starter.picks.map((n) => skills.find((s) => s.meta.name === n)!).filter(Boolean);
        const cost = tokens(list.reduce((n, s) => n + s.meta.installableWords, 0));
        return (
          <a class="quick-card" href="/starters" data-reveal={String(i + 1)}>
            <strong>{starter.title}</strong>
            <p>{list.map((s) => s.meta.skill).join(' · ')}</p>
            <span><b>{list.length}</b> layers · <b>~{cost.toLocaleString()}</b> tokens</span>
          </a>
        );
      })}
    </div>
      </section>

    </div>
  </div>
</Base>

<style is:global>
  .anatomy-band { padding: var(--section) 0 0; }

  .behaviour { padding: var(--section) 0 0; }
  /* four steps beside the thing they describe, rather than a row across the page with the
     evidence stranded underneath it */
  .behaviour-grid {
    display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--sp-6); align-items: center;
  }
  .acts { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--sp-4); }
  .proof {
    border: 1px solid var(--rule); border-radius: var(--r-lg);
    background: var(--raised); box-shadow: var(--shadow); overflow: hidden;
  }
  .act { display: grid; grid-template-columns: 2rem minmax(0, 1fr); gap: var(--sp-2); align-items: start; }
  .act-n { font-size: var(--fs-micro); font-weight: 700; color: var(--accent); padding-top: 0.2rem; }
  .act-name { margin: 0 0 0.35rem; font-size: var(--fs-body); font-weight: 600; }
  .act-say { margin: 0; font-size: var(--fs-ui); color: var(--ink-soft); }

  .quick { padding: var(--section) 0 var(--sp-5); }
  .quick-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: var(--sp-3); }
  .quick-card {
    border: 1px solid var(--rule); border-radius: var(--r-md); background: var(--raised);
    padding: 1.2rem 1.3rem; text-decoration: none; display: grid; gap: var(--sp-2);
  }
  .quick-card:hover { border-color: var(--rule-strong); }
  .quick-card p { margin: 0; color: var(--ink-soft); font-size: var(--fs-meta); }
  .quick-card span { font-size: var(--fs-micro); color: var(--ink-faint); }
  .quick-card b { color: var(--gold); font-weight: 600; }

  @media (max-width: 900px) {
    .behaviour-grid { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 820px) {
    .axis-item { grid-template-columns: minmax(0, 1fr); gap: var(--sp-2); }
    .measured p { margin-left: 0; }
  }

  .anatomy-band, .behaviour, .quick { padding: var(--sp-6) 0 0; scroll-margin-top: 5rem; }
</style>
