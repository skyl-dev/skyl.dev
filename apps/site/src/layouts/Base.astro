---
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** Which nav item is the current page. */
  section?: string;
}
const { title, description, section } = Astro.props;
const path = Astro.url.pathname;

const NAV = [
  // what someone came for first, then how to get it, then the explanation
  { href: '/skills', label: 'Skills', key: 'skills' },
  { href: '/install', label: 'Install', key: 'install' },
  { href: '/how-it-works', label: 'How it works', key: 'how' },
  { href: '/docs', label: 'Docs', key: 'docs' },
  { href: '/starters', label: 'Starters', key: 'starters' },
  { href: '/evidence', label: 'Evidence', key: 'evidence' },
  { href: '/spec', label: 'Spec', key: 'spec' },
];
const full = title === 'skyl' ? 'skyl, composable agent skills' : `${title} · skyl`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400..700&display=swap"
    />
  </head>
  <body>
    <script is:inline>
      // set before paint, so nothing flashes in and then hides again
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.setAttribute('data-motion', '');
      }
    </script>
    <header class="masthead">
      <div class="shell masthead-inner">
        <a class="wordmark" href="/">
          <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          skyl
        </a>
        <nav class="nav">
          {NAV.map((item) => (
            <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="masthead-end">
          <a class="ghost" href="https://www.npmjs.com/package/skyl.dev">npm</a>
          <a class="ghost" href="https://github.com/skyl-dev/skyl" aria-label="GitHub">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="site">
      <div class="shell footer-inner">
        <div class="footer-say">
          <a class="wordmark" href="/">
            <span class="mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            skyl
          </a>
          <p>
            Curated agent skills, split by axis, so a project loads the intersection that applies to
            it rather than one file that tries to cover everything.
          </p>
        </div>

        <div class="footer-col">
          <p class="eyebrow">Start</p>
          <a href="/how-it-works">How it works</a>
          <a href="/install">Install</a>
          <a href="/#pick">Compose a stack</a>
          <a href="/starters">Starters</a>
          <a href="/docs">CLI commands</a>
        </div>

        <div class="footer-col">
          <p class="eyebrow">Registry</p>
          <a href="/skills">All skills</a>
          <a href="/spec">Format and axes</a>
          <a href="/evidence">Evidence</a>
          <a href="/contributors">Contributors</a>
        </div>

        <div class="footer-col">
          <p class="eyebrow">Source</p>
          <a href="https://github.com/skyl-dev/skyl">Registry repo</a>
          <a href="https://github.com/skyl-dev/skyl.dev">Site and CLI</a>
          <a href="https://www.npmjs.com/package/skyl.dev">npm package</a>
          <a href="https://github.com/skyl-dev/skyl/blob/main/CONTRIBUTING.md">Contributing</a>
        </div>
      </div>

      <div class="shell footer-base">
        <span>MIT licensed</span>
        <span class="spacer">Skills are proposed, never installed without asking.</span>
      </div>
    </footer>
    <script>
      /*
       * The rail follows the reading position, on every page that has one. This used to be
       * two copies of an IntersectionObserver living in two pages, which left the other five
       * rails inert, and which marked nothing at all whenever no heading happened to be
       * inside the observed band. Position beats observation here: read where the sections
       * are, take the last one that has crossed the reading line, done.
       */
      const rail = document.querySelector('.docs-rail');
      const scroller = rail?.querySelector('.rail-inner');
      const items = [...(rail?.querySelectorAll('a[data-rail]') ?? [])]
        .map((link) => ({ link, target: document.getElementById(link.getAttribute('data-rail')) }))
        .filter((item) => item.target);

      if (items.length) {
        let marked = null;

        /*
         * Mark whichever section owns most of the screen.
         *
         * A fixed reading line cannot do this. Set just under the masthead it marks whatever has
         * scrolled past, so on a page of long sections the rail said Security while the screen
         * showed Build. Set halfway down it marks too early on a page whose sections are shorter
         * than the offset, which is most of /docs. There is no one line that fits both, because
         * the answer depends on how tall the sections are, so this measures instead: each item
         * owns from its own heading to the next one, clipped to the viewport, and the widest span
         * wins. The last section is short by definition, so the end of the page hands it the mark.
         */
        const follow = () => {
          const view = window.innerHeight;
          let current = items[0];
          let widest = -1;
          for (let i = 0; i < items.length; i += 1) {
            const top = items[i].target.getBoundingClientRect().top;
            const next = items[i + 1]?.target.getBoundingClientRect().top ?? Infinity;
            const seen = Math.min(view, next) - Math.max(0, top);
            if (seen > widest) { widest = seen; current = items[i]; }
          }
          const bottom = window.scrollY + view >= document.documentElement.scrollHeight - 2;
          if (bottom) current = items[items.length - 1];

          if (current.link === marked) return;
          marked = current.link;
          for (const item of items) item.link.toggleAttribute('data-on', item.link === marked);

          // when the rail is scrolling itself, the mark has to stay somewhere you can see it
          if (scroller && scroller.scrollHeight > scroller.clientHeight + 4) {
            const mark = marked.getBoundingClientRect();
            const box = scroller.getBoundingClientRect();
            if (mark.top < box.top + 24 || mark.bottom > box.bottom - 24) {
              scroller.scrollTo({
                top: scroller.scrollTop + (mark.top - box.top) - scroller.clientHeight / 3,
                behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
              });
            }
          }
        };

        let pending = false;
        const onScroll = () => {
          if (pending) return;
          pending = true;
          requestAnimationFrame(() => { pending = false; follow(); });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        window.addEventListener('hashchange', onScroll);
        follow();
      }
    </script>

    <script>
      // one observer for the page: anything marked [data-reveal] rises into place once,
      // and the delay is read off the element so a group can stagger
      const targets = document.querySelectorAll('[data-reveal]');
      if (targets.length && 'IntersectionObserver' in window) {
        const watcher = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target;
            const step = Number(el.getAttribute('data-reveal')) || 0;
            window.setTimeout(() => el.setAttribute('data-shown', ''), step * 70);
            watcher.unobserve(el);
          }
        }, { rootMargin: '0px 0px -12% 0px', threshold: 0.08 });

        for (const target of targets) watcher.observe(target);
      } else {
        for (const target of targets) target.setAttribute('data-shown', '');
      }

      // a floor, not a feature: anything still hidden after three seconds is shown
      // regardless, so a missed observer can never leave a section invisible
      window.setTimeout(() => {
        for (const target of document.querySelectorAll('[data-reveal]:not([data-shown])')) {
          target.setAttribute('data-shown', '');
        }
      }, 3000);
    </script>
  </body>
</html>
