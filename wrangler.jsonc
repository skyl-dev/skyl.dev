{
  // The site, as a Worker serving static assets. No server code: everything here is a
  // rendering of a git repository, so anything dynamic would be a cache of something
  // already static.
  //
  // A Worker rather than Pages, for one reason that is hard to undo. A Pages project is
  // either direct upload or git connected, and Cloudflare's docs are explicit that the
  // first cannot become the second: "you cannot switch to Git integration later. You will
  // have to create a new project." Deploying Pages from a terminal would therefore rule
  // out ever deploying it from a push. Workers Builds attaches to a Worker that already
  // exists, so the two are not exclusive.
  "name": "skyl-dev",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./apps/site/dist",

    // The site sets `trailingSlash: 'never'` and builds `skills.html` rather than
    // `skills/index.html`, so `/skills` has to serve that file and `/skills/` has to
    // redirect to it. The default, auto-trailing-slash, would accept both spellings and
    // leave two URLs for one page.
    "html_handling": "drop-trailing-slash",

    // Not "single-page-application": this is many pages, and serving index.html for an
    // unknown path would answer 200 for everything that does not exist, including
    // /registry.json if it ever failed to build.
    "not_found_handling": "404-page"
  }

  // The custom domain, once the first deploy is confirmed on the workers.dev URL.
  // Uncommenting this and deploying again creates the domain and its DNS record, since
  // skyl.dev is already a zone on Cloudflare. It is separate from the first deploy on
  // purpose: a deploy that both uploads a site for the first time and edits DNS has two
  // ways to fail and one error message.
  //
  // "routes": [{ "pattern": "skyl.dev", "custom_domain": true }]
}
